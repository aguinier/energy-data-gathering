# Energy data updates (4x daily)
30 0 * * * cd /app && /usr/local/bin/python3 scripts/update.py >> /app/logs/cron_update.log 2>&1
30 6 * * * cd /app && /usr/local/bin/python3 scripts/update.py >> /app/logs/cron_update.log 2>&1
30 13 * * * cd /app && /usr/local/bin/python3 scripts/update.py >> /app/logs/cron_update.log 2>&1
30 18 * * * cd /app && /usr/local/bin/python3 scripts/update.py >> /app/logs/cron_update.log 2>&1

# Day-ahead PRICE only, right after the SDAC market-coupling publication.
# The auction publishes the whole of the next market day at ~12:45 Brussels
# local, which is 10:45 UTC under CEST and 11:45 UTC under CET — hence two
# lines rather than one: 11:15 catches the summer publication promptly, 12:15
# catches the winter one and doubles as a retry for the summer.
#
# Without these the first pass that can see tomorrow's price is the 13:30 full
# update, and it is the ONLY one before evening. On 2026-08-06 that pass was
# wiped out by an ENTSO-E outage — 484 HTTP 503s, 0 of 30 countries stored,
# every document type — and tomorrow's price was absent from the dashboard
# until 18:35. Two cheap independent attempts ahead of it stop a single
# transient upstream failure from being an 8-hour hole in the most-read number
# on the board. Measured cost: A44 for ~30 countries at ~1.8s each, so ~90s.
#
# `--types price` is enough to turn D+1 fetching on: update.py auto-enables
# include_dayahead from config's is_dayahead flags and price carries one.
# The other three day-ahead types (load_forecast_day_ahead, wind_solar_forecast,
# net_position) have the same exposure and are deliberately NOT here yet —
# adding them is a one-word change, pending a call on the extra runtime.
# See ABL-54 / ABL-51.
15 11 * * * cd /app && /usr/local/bin/python3 scripts/update.py --types price --days 2 >> /app/logs/cron_update.log 2>&1
15 12 * * * cd /app && /usr/local/bin/python3 scripts/update.py --types price --days 2 >> /app/logs/cron_update.log 2>&1

# Weather data + forecasts (daily at 15:00 UTC) — legacy `weather_data` table
0 15 * * * cd /app && /usr/local/bin/python3 scripts/update_weather.py --forecast >> /app/logs/cron_weather.log 2>&1

# Versioned weather_observation — HOURLY real-time ingest.
# Pulls /v1/forecast for all 7 NWP models (best_match, ecmwf_ifs025,
# icon_seamless, gfs_seamless, knmi_harmonie_arome_europe,
# meteofrance_arome_france, icon_d2) × all weather_location rows at
# XX:30 UTC. Heliocast's :45 UTC runner reads straight from the DB
# (via GET /api/weather/latest) so the forecast it uses is ≤ 15 min old.
30 * * * * cd /app && /usr/local/bin/python3 scripts/update_weather_observation_hourly.py >> /app/logs/cron_weather_obs_hourly.log 2>&1

# Versioned weather_observation — 3×/day heavy ingest.
# Adds Previous Runs API (day1 + day2 + day3 × 7 NWP models) to the realtime
# pulls. Timed after NWP publishing windows:
#  07:00 UTC catches 00Z runs (~5-7h lag), ahead of Predico 08:00 gate
#  13:30 UTC catches 06Z runs (shares window with energy ingest)
#  19:30 UTC catches 12Z runs
0  7 * * * cd /app && /usr/local/bin/python3 scripts/update_weather_observation.py >> /app/logs/cron_weather_obs.log 2>&1
30 13 * * * cd /app && /usr/local/bin/python3 scripts/update_weather_observation.py >> /app/logs/cron_weather_obs.log 2>&1
30 19 * * * cd /app && /usr/local/bin/python3 scripts/update_weather_observation.py >> /app/logs/cron_weather_obs.log 2>&1

# Late-publisher catch-up (ABL-84/ABL-85), weekly.
# scripts/update.py only ever refetches a trailing 7-day window, so a zone
# that goes dark for longer than that and later republishes is never
# re-requested once the outage slides out of that window — even though
# ENTSO-E is still holding the data. AL and CY both do this (measured
# 2026-08-09: hundreds to over a thousand points sitting unclaimed upstream);
# MK/MD go dark over similar spans and genuinely never publish the missing
# hours, which this job does not need to know in advance — it just gets an
# empty response back for those and moves on.
#
# Weekly, not daily: the recoverable window stays open for weeks after a zone
# resumes (AL's June gap was still fetchable in August), and a country with no
# interior holes costs this job one bounded, indexed SELECT against
# energy_load and zero ENTSO-E requests — there is no standing cost to a
# healthy zone that would justify running it more often. 05:00 UTC Sunday sits
# clear of every other scheduled job above.
0 5 * * 0 cd /app && /usr/local/bin/python3 scripts/catchup.py >> /app/logs/cron_catchup.log 2>&1
